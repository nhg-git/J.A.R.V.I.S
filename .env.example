# ──────────────────────────────────────────────────────────────
#  J.A.R.V.I.S — Environment Configuration
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────
# Use "ollama" (free, local) or "openai" (requires API key)
LLM_PROVIDER=ollama

# Ollama settings (free — install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional fallback — costs money)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Voice ─────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium (bigger = better but slower)
WHISPER_MODEL_SIZE=base

# Edge TTS voice (all are free)
# Options: en-US-GuyNeural | en-US-AriaNeural | en-GB-RyanNeural | en-GB-SoniaNeural
TTS_VOICE=en-US-GuyNeural

# Enable voice features
ENABLE_VOICE=true
ENABLE_TTS=true

# ── Research ──────────────────────────────────────────────────
# DuckDuckGo is used by default (no API key needed)
# Optional: Brave Search for better results
BRAVE_API_KEY=

MAX_SEARCH_RESULTS=5
MAX_SCRAPE_PAGES=3

# ── App Settings ──────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
